{
  "name": "recept-5.0",
  "private": true,
  "version": "5.0.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vitest run && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "test:all": "vitest run && playwright test",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:properties": "vitest run tests/unit/properties.test.ts",
    "build:nocheck": "vite build",
    "test:golden:update": "vitest run tests/unit/golden.test.ts -u",
    "data:update": "node scripts/data/update.ts",
    "data:update:fass": "node scripts/data/update.ts --only=fass",
    "data:update:janusmed": "node scripts/data/update.ts --only=janusmed",
    "data:check": "node scripts/data/update.ts --dry-run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.52.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^4.1.7",
    "acorn": "^8.18.0",
    "fast-check": "^4.8.0",
    "jsdom": "^29.1.1",
    "puppeteer": "^25.0.4",
    "svelte": "^5.55.9",
    "svelte-check": "^4.1.5",
    "typescript": "~6.0",
    "vite": "^7.3.3",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.18"
  }
}
